# Copy to /etc/gatus/gatus.env and replace example URLs.
# The host running Gatus must have the same VPN/DNS access as its users.
VAULT_WEB_URL=https://vault.example.com/
CLOUD_PAGE_URL=https://vault.example.com/cloud/
VAULTWARDEN_URL=https://vaultwarden.example.internal/
VAULT_HABITS_URL=https://habits.example.com/
VAULT_WEBSOCKET_URL=wss://vault.example.com/ws-chat
